{
	"FileVersion": 3,
	"Version": 1,
	"VersionName": "1.0",
	"FriendlyName": "Skyfold Studio",
	"Description": "Imports worlds exported by Skyfold Studio: creates the Landscape (heights, weight-blended layers, cave holes) for import_world.py, and the world's runtime.",
	"Category": "Import",
	"CreatedBy": "Skyfold Studio",
	"CanContainContent": false,
	"Installed": false,
	"Modules": [
		{ "Name": "SkyfoldStudio", "Type": "Runtime", "LoadingPhase": "Default" },
		{ "Name": "SkyfoldStudioEditor", "Type": "Editor", "LoadingPhase": "Default" }
	],
	"Plugins": [
		{ "Name": "PythonScriptPlugin", "Enabled": true },
		{ "Name": "EditorScriptingUtilities", "Enabled": true }
	]
}
